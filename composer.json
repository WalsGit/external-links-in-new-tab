{
    "name": "walsgit/external-links-in-new-tab",
    "description": "Opens all external links in a new tab",
    "keywords": [
        "flarum",
        "flarum-extension",
        "extension",
        "links",
        "url",
        "forum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0.0"
    },
    "authors": [
        {
            "name": "Wa!id",
            "homepage": "https://discuss.flarum.org/u/Walid"
        }
    ],
    "funding": [
        {
            "type": "website",
            "url": "https://walsgit.github.io/Donations/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Walsgit\\ExternalLinksInNewTab\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "External Links In New Tab",
            "category": "feature",
            "icon": {
                "name": "fas fa-external-link-alt",
                "color": "#fff",
                "backgroundColor": "#008e97"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": false,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": false,
                "locale": false,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "support": {
        "issues": "https://github.com/WalsGit/external-links-in-new-tab/issues",
        "source": "https://github.com/WalsGit/external-links-in-new-tab",
        "forum": "https://discuss.flarum.org/d/36348-external-links-in-new-tab"
    }
}